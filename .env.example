# App / queue
PORT=3004
REDIS_URL=redis://127.0.0.1:6379
STATE_TTL_SECONDS=604800
JOB_CONCURRENCY=1

# BMW Aftersales Flat Rates API
BMW_API_ACCESS_TOKEN_URL=https://auth.bmwgroup.com/auth/oauth2/machine2machine/access_token
BMW_API_TOKEN_INFO_URL=https://auth.bmwgroup.com/auth/oauth2/tokeninfo
BMW_API_CLIENT_ID=
BMW_API_CLIENT_SECRET=
BMW_API_KEY=
BMW_API_BASE_URL=https://apim.bmwgroup.com/aftersales/flatrates/v1
BMW_VEHICLE_ID_BASE_URL=https://apim.bmwgroup.com/aftersales/vehicle-identification/type-research/v1
BMW_API_TIMEOUT_MS=10000
BMW_API_LANGUAGE=en-GB
BMW_RATE_LIMIT_PER_SEC=3
BMW_RATE_LIMIT_MAX_COOLDOWN_MS=1800000
BMW_AW_SHEET_CHUNK_SIZE=25
BMW_MAX_RETRIES=5

# S3 compatible storage
S3_ENDPOINT=https://s3-eu.solera.farm
S3_REGION=us-east-1
S3_ACCESS_KEY=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=magnets-reader-dev
S3_PREFIX=BMW_GROUP/files_datasource/Labour_Time
S3_FORCE_PATH_STYLE=true
S3_AUTO_CREATE_BUCKET=false
S3_CONNECT_TIMEOUT_MS=5000
S3_REQUEST_TIMEOUT_MS=30000

# SQL Server. Defaults reflect legacy acciona names; configure host/user locally.
BMW_SQL_SERVER=
BMW_SQL_DATABASE=BMW_Labour
BMW_SQL_DATAREQUEST_DATABASE=DataRequestBMW
BMW_SQL_USER=
BMW_SQL_PASSWORD=
BMW_SQL_PORT=1433
BMW_SQL_ENCRYPT=true
BMW_SQL_TRUST_SERVER_CERTIFICATE=false
BMW_SQL_CONNECTION_TIMEOUT_MS=30000
BMW_SQL_REQUEST_TIMEOUT_MS=120000
BMW_SQL_ALLOWED_DATABASES=BMW_Labour,DataRequestBMW
BMW_CONFIRM_PRODUCTION=false
BMW_SQL_SCHEMA_VERIFIED=false

# cargaInicial JSON directory (same data hierarchy as acciona's share)
BMW_CARGA_INICIAL_ROOT=
