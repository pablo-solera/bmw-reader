# App / queue
PORT=3004
REDIS_URL=redis://127.0.0.1:6379
STATE_TTL_SECONDS=604800
JOB_CONCURRENCY=1

# BMW Aftersales Flat Rates API
BMW_API_ACCESS_TOKEN_URL=https://auth.bmwgroup.com/auth/oauth2/machine2machine/access_token
BMW_API_CLIENT_ID=
BMW_API_CLIENT_SECRET=
BMW_API_KEY=
BMW_API_BASE_URL=https://apim.bmwgroup.com/aftersales/flatrates/v1
BMW_VEHICLE_ID_BASE_URL=https://apim.bmwgroup.com/aftersales/vehicle-identification/type-research/v1
BMW_API_TIMEOUT_MS=10000
BMW_MODEL_OPTIONS_RATE_LIMIT_WAIT_MS=2000
BMW_API_TOKEN_POOL_SIZE=10
BMW_API_LANGUAGE=en-GB
# BMW docs limit this API key/app to 3 req/s globally; higher rates are experimental
BMW_RATE_LIMIT_PER_SEC=3
BMW_RATE_LIMIT_MAX_COOLDOWN_MS=1800000
BMW_RATE_LIMIT_MIN_TIME_MS=25
BMW_AW_SHEET_CONCURRENCY=8
BMW_5XX_RETRY_WINDOW_MS=600000

# S3 compatible storage
S3_ENDPOINT=https://s3-eu.solera.farm
S3_REGION=us-east-1
S3_ACCESS_KEY=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=magnets-reader-dev
S3_PREFIX=
S3_FORCE_PATH_STYLE=true
S3_AUTO_CREATE_BUCKET=false
